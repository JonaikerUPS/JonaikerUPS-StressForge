export default function LoginPage() {
  const [username, setUsername] = useState("");
  const [isFocused, setIsFocused] = useState(false);
  const [isDarkMode, setIsDarkMode] = useState(true);
  const router = useRouter();
  const { login } = useAuth();

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (username.trim()) {
      login(username.trim());
      router.push("/dashboard");
    }
  };

  const getLeftLineColor = (line: string) => {
    if (line.includes("██") || line.includes("┌─") || line.includes("│") || line.includes("_  _")) {
      return isDarkMode ? "text-emerald-500/80 font-bold" : "text-emerald-600/80 font-bold";
    }
    if (line.includes("_______") || line.includes("|       |")) {
      return isDarkMode ? "text-teal-400 font-bold" : "text-teal-600 font-bold";
    }
    if (line.includes("[CRITICAL]") || line.includes("tar -czf") || line.includes("WARNING:")) {
      return isDarkMode ? "text-rose-500 font-bold animate-pulse" : "text-rose-600 font-bold animate-pulse";
    }
    if (line.includes("[+]") || line.includes("uid=0")) {
      return isDarkMode ? "text-green-400 font-semibold" : "text-green-600 font-semibold";
    }
    if (line.includes("SELECT") || line.includes("POST") || line.includes("GET")) {
      return isDarkMode ? "text-cyan-400" : "text-cyan-600";
    }
    if (line.includes("[ATTACK]") || line.includes("[!]")) {
      return isDarkMode ? "text-amber-400" : "text-amber-600";
    }
    return isDarkMode ? "text-slate-400/50" : "text-slate-400/80";
  };

  const getRightLineColor = (line: string) => {
    if (line.includes("██") || line.includes("▓▓") || line.includes("_     _")) {
      return isDarkMode ? "text-cyan-500/80 font-bold" : "text-cyan-600/80 font-bold";
    }
    if (line.includes("_____  _")) {
      return isDarkMode ? "text-purple-400 font-bold" : "text-purple-600 font-bold";
    }
    if (line.includes("[DATA_STEAL]") || line.includes("[!]")) {
      return isDarkMode ? "text-rose-500 font-bold" : "text-rose-600 font-bold";
    }
    if (line.includes("[SUCCESS]") || line.includes("[STATUS]")) {
      return isDarkMode ? "text-emerald-400 font-bold" : "text-emerald-600 font-bold";
    }
    if (line.includes("[DUMP]") || line.includes("mimikatz")) {
      return isDarkMode ? "text-amber-400" : "text-amber-600";
    }
    if (line.includes("[DEBUG]")) {
      return isDarkMode ? "text-sky-400/80" : "text-sky-600/80";
    }
    return isDarkMode ? "text-slate-400/60" : "text-slate-400/90";
  };

  return (
    <div className={`relative flex min-h-screen flex-col overflow-hidden transition-colors duration-300 ${isDarkMode ? "bg-slate-950" : "bg-slate-50"}`}>
      {/* Background: Glow orbs + Code Stream */}
      <div aria-hidden="true" className="pointer-events-none absolute inset-0 overflow-hidden">
        {/* Glow Orbs */}
        <div className={`absolute -top-40 left-1/2 h-[600px] w-[600px] -translate-x-1/2 rounded-full blur-[120px] transition-colors duration-300 ${isDarkMode ? "bg-emerald-600/10" : "bg-emerald-500/10"}`} />
        <div className={`absolute bottom-0 left-0 h-[400px] w-[400px] -translate-x-1/2 translate-y-1/2 rounded-full blur-[100px] transition-colors duration-300 ${isDarkMode ? "bg-cyan-600/10" : "bg-cyan-500/10"}`} />
        <div className={`absolute right-0 top-1/2 h-[350px] w-[350px] translate-x-1/2 -translate-y-1/2 rounded-full blur-[90px] transition-colors duration-300 ${isDarkMode ? "bg-rose-500/5" : "bg-rose-500/10"}`} />

        {/* Animated Code Streams (Bucle denso, simétrico e infinito) */}
        <div
          className={`absolute inset-0 flex justify-between overflow-hidden font-mono text-[12px] leading-relaxed transition-opacity duration-300 ${isDarkMode ? "opacity-[0.35]" : "opacity-[0.22]"}`}
          style={{
            maskImage: "linear-gradient(to bottom, transparent, black 15%, black 85%, transparent)",
            WebkitMaskImage: "linear-gradient(to bottom, transparent, black 15%, black 85%, transparent)"
          }}
        >
          {/* Stream Left */}
          <div className={`relative w-1/2 h-full overflow-hidden border-r ${isDarkMode ? "border-white/[0.02]" : "border-slate-900/[0.04]"}`}>
            <div
              className="absolute w-full flex flex-col"
              style={{
                animation: "scroll-code 55s linear infinite",
                height: "200%"
              }}
            >
              <div className="h-1/2 flex flex-col gap-3 justify-start pt-4">
                {CODE_LINES_LEFT.map((line, i) => (
                  <pre key={`l1-${i}`} className={`${getLeftLineColor(line)} whitespace-pre pl-6 tracking-wide`}>
                    {line}
                  </pre>
                ))}
              </div>
              <div className="h-1/2 flex flex-col gap-3 justify-start pt-4" aria-hidden="true">
                {CODE_LINES_LEFT.map((line, i) => (
                  <pre key={`l2-${i}`} className={`${getLeftLineColor(line)} whitespace-pre pl-6 tracking-wide`}>
                    {line}
                  </pre>
                ))}
              </div>
            </div>
          </div>

          {/* Stream Right */}
          <div className="relative w-1/2 h-full overflow-hidden">
            <div
              className="absolute w-full flex flex-col items-end text-right"
              style={{
                animation: "scroll-code 60s linear infinite",
                height: "200%"
              }}
            >
              <div className="h-1/2 flex flex-col gap-3 justify-start pt-4 pr-6">
                {CODE_LINES_RIGHT.map((line, i) => (
                  <pre key={`r1-${i}`} className={`${getRightLineColor(line)} whitespace-pre tracking-wide`}>
                    {line}
                  </pre>
                ))}
              </div>
              <div className="h-1/2 flex flex-col gap-3 justify-start pt-4 pr-6" aria-hidden="true">
                {CODE_LINES_RIGHT.map((line, i) => (
                  <pre key={`r2-${i}`} className={`${getRightLineColor(line)} whitespace-pre tracking-wide`}>
                    {line}
                  </pre>
                ))}
              </div>
            </div>
          </div>
        </div>

        {/* Grid pattern overlay */}
        <div
          className={`absolute inset-0 transition-opacity duration-300 ${isDarkMode ? "opacity-[0.02]" : "opacity-[0.03]"}`}
          style={{
            backgroundImage: isDarkMode
              ? "linear-gradient(rgba(255,255,255,1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,1) 1px, transparent 1px)"
              : "linear-gradient(rgba(15,23,42,1) 1px, transparent 1px), linear-gradient(90deg, rgba(15,23,42,1) 1px, transparent 1px)",
            backgroundSize: "40px 40px",
          }}
        />
      </div>

      {/* Top nav bar */}
      <header className={`relative z-10 flex items-center justify-between border-b px-6 py-4 sm:px-10 backdrop-blur-md transition-colors duration-300 ${isDarkMode ? "border-white/5 bg-slate-950/40" : "border-slate-200/60 bg-white/60"}`}>
        <div className="flex items-center gap-2.5">
          <div className={`flex h-8 w-8 items-center justify-center rounded-lg shadow-lg ${isDarkMode ? "bg-emerald-500 shadow-emerald-500/20" : "bg-emerald-600 shadow-emerald-600/10"}`}>
            <Zap className={`h-4 w-4 ${isDarkMode ? "text-slate-950" : "text-white"}`} />
          </div>
          <span className={`text-sm font-bold tracking-wider uppercase transition-colors duration-300 ${isDarkMode ? "text-white" : "text-slate-800"}`}>StressForge // SecSuite</span>
        </div>

        <div className="flex items-center gap-4">
          {/* Light/Dark Mode Switcher Button */}
          <button
            onClick={() => setIsDarkMode(!isDarkMode)}
            className={`p-2 rounded-xl border transition-all duration-200 hover:scale-105 ${isDarkMode
                ? "border-white/10 bg-white/5 text-amber-400 hover:bg-white/10"
                : "border-slate-200 bg-slate-100 text-purple-600 hover:bg-slate-200"
              }`}
            title={isDarkMode ? "Cambiar a Modo Blanco" : "Cambiar a Modo Oscuro"}
          >
            {isDarkMode ? <Sun className="h-4 w-4" /> : <Moon className="h-4 w-4" />}
          </button>

          <div className={`flex items-center gap-1.5 rounded-full border px-3 py-1.5 transition-colors duration-300 ${isDarkMode ? "border-emerald-500/20 bg-emerald-500/5" : "border-emerald-600/20 bg-emerald-5/80"}`}>
            <Activity className={`h-3 w-3 animate-pulse ${isDarkMode ? "text-emerald-400" : "text-emerald-600"}`} />
            <span className={`text-xs font-mono tracking-wide uppercase ${isDarkMode ? "text-emerald-400/90" : "text-emerald-700 font-medium"}`}>C2 Node Linked</span>
          </div>
        </div>
      </header>

      {/* Main content */}
      <main className="relative z-10 flex flex-1 items-center justify-center p-6">
        <div className="w-full max-w-md">
          {/* Card */}
          <div className={`overflow-hidden rounded-2xl border backdrop-blur-2xl transition-all duration-300 ${isDarkMode ? "border-white/10 bg-slate-900/[0.4] shadow-2xl shadow-black/80" : "border-slate-200 bg-white shadow-xl shadow-slate-200/50"}`}>
            {/* Card top accent line */}
            <div className="h-px w-full bg-gradient-to-r from-transparent via-emerald-500/40 to-transparent" />

            <div className="p-8 sm:p-10">
              {/* Header */}
              <div className="mb-8">
                <div className={`mb-5 inline-flex items-center gap-2 rounded-full border px-3 py-1.5 transition-colors duration-300 ${isDarkMode ? "border-rose-500/30 bg-rose-500/10" : "border-rose-200 bg-rose-50"}`}>
                  <span className="h-1.5 w-1.5 rounded-full bg-rose-500 animate-ping" />
                  <span className={`text-xs font-mono font-semibold uppercase tracking-widest ${isDarkMode ? "text-rose-400" : "text-rose-700 font-bold"}`}>
                    Terminal Protegida
                  </span>
                </div>
                <h1 className={`text-2xl font-bold tracking-tight sm:text-3xl font-mono transition-colors duration-300 ${isDarkMode ? "text-white" : "text-slate-900"}`}>
                  Initialize Session
                </h1>
                <p className={`mt-2 text-sm transition-colors duration-300 ${isDarkMode ? "text-slate-400" : "text-slate-600"}`}>
                  Por favor introduce tus credenciales criptográficas de operador para desplegar el entorno de testeo de vulnerabilidades.
                </p>
              </div>

              {/* Form */}
              <form onSubmit={handleSubmit} className="space-y-5">
                <div className="space-y-1.5">
                  <label
                    htmlFor="username"
                    className="block text-xs font-mono font-semibold uppercase tracking-widest text-slate-500"
                  >
                    Identificador de Operador / Token
                  </label>
                  <div
                    className={`relative flex items-center rounded-xl border transition-all duration-200 ${isFocused
                        ? isDarkMode
                          ? "border-emerald-500/50 bg-emerald-500/5 shadow-[0_0_0_3px_rgba(16,185,129,0.1)]"
                          : "border-emerald-500 bg-emerald-5/30 shadow-[0_0_0_3px_rgba(16,185,129,0.15)]"
                        : isDarkMode
                          ? "border-white/10 bg-white/5 hover:border-white/20"
                          : "border-slate-200 bg-slate-50 hover:border-slate-300"
                      }`}
                  >
                    <div className="pointer-events-none flex h-full items-center pl-3.5">
                      <User
                        className={`h-4 w-4 transition-colors duration-200 ${isFocused ? (isDarkMode ? "text-emerald-400" : "text-emerald-600") : "text-slate-500"}`}
                      />
                    </div>
                    <input
                      id="username"
                      type="text"
                      value={username}
                      onChange={(e) => setUsername(e.target.value)}
                      onFocus={() => setIsFocused(true)}
                      onBlur={() => setIsFocused(false)}
                      placeholder="ej. root, admin_sec..."
                      className={`w-full bg-transparent py-3 pl-3 pr-4 text-sm font-mono outline-none transition-colors duration-300 ${isDarkMode ? "text-white placeholder-slate-600" : "text-slate-800 placeholder-slate-400"}`}
                      autoFocus
                      autoComplete="off"
                    />
                  </div>
                </div>

                <button
                  type="submit"
                  disabled={!username.trim()}
                  className={`group relative flex w-full items-center justify-center gap-2.5 overflow-hidden rounded-xl px-4 py-3 text-sm font-semibold transition-all duration-200 disabled:cursor-not-allowed ${isDarkMode
                      ? "bg-emerald-500 text-slate-950 shadow-lg shadow-emerald-500/20 hover:bg-emerald-400 hover:shadow-emerald-400/30 disabled:opacity-30 disabled:shadow-none"
                      : "bg-emerald-600 text-white shadow-md shadow-emerald-600/10 hover:bg-emerald-500 hover:shadow-lg hover:shadow-emerald-500/20 disabled:opacity-40 disabled:shadow-none"
                    }`}
                >
                  <span className="font-mono uppercase tracking-wider">Bypassing Gate / Acceder</span>
                  <ArrowRight className="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" />
                  <span
                    aria-hidden="true"
                    className="absolute inset-0 -translate-x-full skew-x-[-20deg] bg-white/10 transition-transform duration-700 group-hover:translate-x-[200%]"
                  />
                </button>
              </form>

              {/* Divider + info */}
              <div className="mt-6 flex items-center gap-3">
                <div className={`h-px flex-1 ${isDarkMode ? "bg-white/5" : "bg-slate-200"}`} />
                <span className="text-xs font-mono text-slate-500 uppercase tracking-tight">Secured Bypass Mode</span>
                <div className={`h-px flex-1 ${isDarkMode ? "bg-white/5" : "bg-slate-200"}`} />
              </div>
            </div>
          </div>

          {/* Capabilities badges */}
          <div className="mt-6 flex flex-wrap justify-center gap-2">
            {["Exploitation", "Data Dumping", "gRPC Pivoting", "SQL Injection Fuzzing"].map((tech) => (
              <span
                key={tech}
                className={`rounded-full border px-3 py-1 text-[11px] font-mono font-medium uppercase tracking-tight shadow-sm transition-colors duration-300 ${isDarkMode ? "border-white/5 bg-slate-900/60 text-slate-500" : "border-slate-200 bg-white text-slate-600"}`}
              >
                {tech}
              </span>
            ))}
          </div>
        </div>
      </main>

      {/* Footer */}
      <footer className={`relative z-10 border-t px-6 py-4 text-center backdrop-blur-md transition-colors duration-300 ${isDarkMode ? "border-white/5 bg-slate-950/20 text-slate-600" : "border-slate-200 bg-white/40 text-slate-500"}`}>
        <p className="text-xs font-mono">
          © 2026{" "}
          <span className={`font-semibold ${isDarkMode ? "text-slate-500" : "text-slate-700"}`}>StressForge Labs</span>
          {" · "} Auditoría de Redes Internas y Exfiltración Autorizada de Bases de Datos.
        </p>
      </footer>
    </div>
  );
}